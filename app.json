{
  "expo": {
    "name": "Conto Spesa",
    "slug": "conto-spesa",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.creaitivity.contospesa"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF6EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "it.creaitivity.contospesa",
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "contospesa",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Conto Spesa usa la fotocamera per leggere il prezzo sulle etichette dei prodotti."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF6EA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
